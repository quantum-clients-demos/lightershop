# ==============================================================================
# Ember & Co. - LighterShopDemo Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# Provide your PostgreSQL connection string here:
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lightershop

# Docker Compose PostgreSQL Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=lightershop

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION
# ------------------------------------------------------------------------------
SECRET_KEY=ember-and-co-ultra-secure-demo-secret-key-2026
ENVIRONMENT=development
DEBUG=True

# ------------------------------------------------------------------------------
# 3. RAZORPAY STANDARD CHECKOUT PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Get your API keys from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_EMBER_DEMO_KEY
RAZORPAY_KEY_SECRET=ember_demo_secret_key_12345
RAZORPAY_WEBHOOK_SECRET=ember_webhook_secret_key

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_EMBER_DEMO_KEY
